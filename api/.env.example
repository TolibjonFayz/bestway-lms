# Best Way LMS API — environment
# Copy to .env and fill in. .env is gitignored; this file is not.

# ── Runtime ──────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
# Port the API listens on.
PORT=3000
# Prefix in front of every route, e.g. /api/auth/login
API_PREFIX=api

# ── Database ─────────────────────────────────────────────────────────────
# Two ways to configure it. DATABASE_URL wins if both are present.
#
# (a) Hosted Postgres (Railway, Neon, Supabase …) — paste the connection
#     string and leave the DB_* lines below empty.
#
#     On Railway: Postgres service → Variables → DATABASE_PUBLIC_URL.
#     It must be the PUBLIC one. DATABASE_URL there points at
#     *.railway.internal, which only resolves inside Railway's own network and
#     will fail with ENOTFOUND from your laptop.
#
#     Format: postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway
#
DATABASE_URL=

# (b) Local PostgreSQL 16. Used only when DATABASE_URL is empty.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bestway_lms
DB_USER=postgres
DB_PASSWORD=

# TLS. Defaults to on for any non-localhost host, off for localhost — set it
# only to override that.
DB_SSL=

# Log every SQL statement to the Nest logger. Noisy — development only.
DB_LOGGING=false

# ── Auth ─────────────────────────────────────────────────────────────────
# Secrets must differ from each other; the app refuses to boot otherwise.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Access tokens are short-lived; refresh tokens rotate on every use.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Cost factor for bcrypt password hashing. 10 is the practical floor.
BCRYPT_ROUNDS=12

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins. The Vite dev server for
# web/ runs on 5190 (see web/vite.config.js).
CORS_ORIGINS=http://localhost:5190

# ── Seed (npm run seed) ──────────────────────────────────────────────────
# Password given to every seeded account. Development only.
SEED_PASSWORD=bestway123
